<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light appearance; values-night/styles.xml swaps the parents for dark. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_ambient</item>
        <item name="android:colorAccent">@color/m3_primary</item>
        <item name="android:colorControlActivated">@color/m3_primary</item>
        <item name="android:textColorHighlight">@color/m3_primary_container</item>
    </style>

    <style name="PlayerTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="RenameDialogTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorAccent">@color/m3_primary</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
    </style>

    <!-- Type scale: M3 Expressive "emphasized" weights on the TV's system sans -->
    <style name="Text" />
    <style name="Text.Display">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">44sp</item>
        <item name="android:textColor">@color/m3_on_surface</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>
    <style name="Text.Headline">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">@color/m3_on_surface</item>
    </style>
    <style name="Text.Status">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/m3_on_surface</item>
    </style>
    <style name="Text.Body">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">18sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:textColor">@color/m3_on_surface_variant</item>
    </style>
    <style name="Text.RowTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="Text.RowValue">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="Text.SectionHeader">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/m3_primary</item>
    </style>
    <style name="Text.Pin">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">56sp</item>
        <item name="android:letterSpacing">0.3</item>
        <item name="android:textColor">@color/m3_on_primary_container</item>
    </style>

    <!-- Pill buttons for dialogs. Focus = primary fill (strong, visible from across the room). -->
    <style name="PillButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:minWidth">168dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:background">@drawable/pill_bg</item>
    </style>
    <style name="PillButton.Emphasis">
        <item name="android:textColor">@color/pill_text_emphasis</item>
        <item name="android:background">@drawable/pill_bg_emphasis</item>
    </style>
</resources>
