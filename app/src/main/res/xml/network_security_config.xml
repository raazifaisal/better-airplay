<?xml version="1.0" encoding="utf-8"?>
<!--
  AirPlay remote control (DACP) talks plain HTTP to the sender on the local network
  (e.g. http://192.168.x.x:50406/ctrl-int/1/playpause). Android can't scope cleartext
  to "local network", so it is allowed; the app makes no other HTTP requests.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
