<?xml version="1.0" encoding="utf-8"?>
<!--
  tvOS Settings layout: artwork + context on the left, a focusable list on the right.
  Content sits inside TV-safe margins (5% of 960x540dp). Shared by Home and Advanced.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="64dp">

        <!-- Left: artwork, title, status, focused-item description -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="11"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <!-- Hero glyph sits directly on the background (no tile), like a tvOS Settings icon. -->
            <ImageView
                android:id="@+id/artwork_icon"
                android:layout_width="144dp"
                android:layout_height="144dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:tint="@color/hero_glyph" />

            <TextView
                android:id="@+id/title"
                style="@style/Text.Display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/shape_dot"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/subtitle"
                    style="@style/Text.Status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:maxLines="2" />
            </LinearLayout>

            <!-- Pairing PIN, shown large while a new device is connecting -->
            <TextView
                android:id="@+id/pin"
                style="@style/Text.Pin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityLiveRegion="assertive"
                android:background="@drawable/shape_pin"
                android:paddingStart="36dp"
                android:paddingTop="10dp"
                android:paddingEnd="24dp"
                android:paddingBottom="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/description"
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:gravity="center"
                android:lineSpacingMultiplier="1.22"
                android:maxLines="7"
                android:maxWidth="440dp"
                android:minLines="3" />
        </LinearLayout>

        <Space
            android:layout_width="48dp"
            android:layout_height="1dp" />

        <!-- Right: focusable list -->
        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="14"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingTop="40dp"
            android:paddingEnd="48dp"
            android:paddingBottom="40dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="16dp"
                android:paddingEnd="24dp"
                android:paddingBottom="16dp" />
        </ScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        style="@style/Text.Status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:background="@drawable/shape_message"
        android:paddingStart="28dp"
        android:paddingTop="14dp"
        android:paddingEnd="28dp"
        android:paddingBottom="14dp"
        android:textSize="18sp"
        android:visibility="gone" />
</FrameLayout>
