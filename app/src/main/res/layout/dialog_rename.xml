<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen text entry, tvOS style. Opaque background (nothing shows through), and everything
  sits in the top half so the TV's on-screen keyboard, which rises from the bottom, never covers
  the field or the actions (WCAG 2.2 "focus not obscured"). The keyboard's ✓ key also saves.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient">

    <LinearLayout
        android:layout_width="840dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="44dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            style="@style/Text.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/rename_title" />

        <TextView
            android:id="@+id/help"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center" />

        <!-- Field and actions on one row, so all of them stay above the keyboard. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/field"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/field_bg"
                android:fontFamily="sans-serif-medium"
                android:hint="@string/rename_hint"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLength="40"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:singleLine="true"
                android:textColor="@color/m3_on_surface"
                android:textColorHint="@color/m3_outline"
                android:textSize="24sp" />

            <Button
                android:id="@+id/save"
                style="@style/PillButton.Emphasis"
                android:layout_height="64dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="0dp"
                android:minWidth="0dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/rename_save" />

            <Button
                android:id="@+id/use_tv_name"
                style="@style/PillButton"
                android:layout_height="64dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="0dp"
                android:minWidth="0dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="@string/rename_use_tv_name" />

            <Button
                android:id="@+id/cancel"
                style="@style/PillButton"
                android:layout_height="64dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="0dp"
                android:minWidth="0dp"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="@string/cancel" />
        </LinearLayout>

        <TextView
            android:id="@+id/preview"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
