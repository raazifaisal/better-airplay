<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen player. video_host gets an AspectFitLayout+SurfaceView; ambient_host gets the Now Playing background. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <FrameLayout
        android:id="@+id/video_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Music Now Playing, Apple Music / tvOS language: ambient wash, big title, metadata columns, round transport. -->
    <FrameLayout
        android:id="@+id/now_playing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/ambient_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top bar: "Now Playing" title on the left, the device it's playing from on the right. -->
        <LinearLayout
            android:id="@+id/np_source_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="72dp"
            android:background="@drawable/pill_source"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="9dp"
            android:paddingEnd="20dp"
            android:paddingBottom="9dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_airplay_small"
                android:tint="#F2FFFFFF" />

            <TextView
                android:id="@+id/np_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#F2FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/np_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="80dp"
            android:layout_marginTop="60dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.12"
            android:text="@string/player_now_playing"
            android:textAllCaps="true"
            android:textColor="#66FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="80dp"
            android:paddingEnd="72dp">

            <!-- Fixed slot so the pause shrink never moves the text -->
            <FrameLayout
                android:layout_width="360dp"
                android:layout_height="360dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/artwork"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_artwork_card"
                    android:clipToOutline="true"
                    android:elevation="20dp"
                    android:foreground="@drawable/artwork_stroke"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="56dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/np_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="true"
                    android:lineSpacingMultiplier="1.03"
                    android:maxLines="2"
                    android:textSize="40sp"
                    android:textColor="@color/np_text"
                    android:textStyle="bold" />

                <!-- Metadata columns (tiny uppercase label + bold value), the signature tvOS "Album of the Day" row.
                     Columns split the width with weights so labels never wrap and values ellipsize in place. -->
                <LinearLayout
                    android:id="@+id/np_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/np_col_artist"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="40dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.07"
                            android:maxLines="1"
                            android:text="@string/player_label_artist"
                            android:textAllCaps="true"
                            android:textColor="#80FFFFFF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/np_artist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textColor="@color/np_text"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/np_col_album"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.07"
                            android:maxLines="1"
                            android:text="@string/player_label_album"
                            android:textAllCaps="true"
                            android:textColor="#80FFFFFF"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/np_album"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textColor="@color/np_text"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/np_progress_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/np_progress_host"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/np_elapsed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:textColor="#99FFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/np_remaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:textColor="#99FFFFFF"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <!-- Round transport (DACP back to the sender). Remote media keys work too. -->
                    <LinearLayout
                        android:id="@+id/np_controls"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="30dp"
                        android:clipChildren="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btn_prev"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/control_bg"
                            android:contentDescription="@string/cd_previous"
                            android:padding="15dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_skip_previous"
                            android:tint="@color/control_icon" />

                        <ImageButton
                            android:id="@+id/btn_play_pause"
                            android:layout_width="74dp"
                            android:layout_height="74dp"
                            android:layout_marginStart="22dp"
                            android:layout_marginEnd="22dp"
                            android:background="@drawable/control_bg_primary"
                            android:contentDescription="@string/cd_play_pause"
                            android:padding="19dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_pause"
                            android:tint="@color/control_icon" />

                        <ImageButton
                            android:id="@+id/btn_next"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/control_bg"
                            android:contentDescription="@string/cd_next"
                            android:padding="15dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_skip_next"
                            android:tint="@color/control_icon" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Connecting / PIN -->
    <LinearLayout
        android:id="@+id/connecting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_ambient"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_airplay"
            android:tint="@color/hero_glyph" />

        <TextView
            android:id="@+id/connecting_caption"
            style="@style/Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:id="@+id/connecting_pin"
            style="@style/Text.Pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:accessibilityLiveRegion="assertive"
            android:background="@drawable/shape_pin"
            android:paddingStart="40dp"
            android:paddingTop="12dp"
            android:paddingEnd="28dp"
            android:paddingBottom="12dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        style="@style/Text.Status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:background="@drawable/shape_message"
        android:paddingStart="28dp"
        android:paddingTop="14dp"
        android:paddingEnd="28dp"
        android:paddingBottom="14dp"
        android:textSize="18sp"
        android:visibility="gone" />
</FrameLayout>
