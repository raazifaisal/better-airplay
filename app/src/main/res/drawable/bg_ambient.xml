<?xml version="1.0" encoding="utf-8"?>
<!-- Light appearance background: tvOS-style silver grey, with a faint neutral lift at the top so it
     reads as brushed metal rather than flat paper. No colour tint.
     drawable-night/bg_ambient.xml is the dark (true black) version. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FFE6E7EA"
                android:endColor="#FFD5D6DA" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.3"
                android:centerY="0.0"
                android:gradientRadius="900dp"
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
