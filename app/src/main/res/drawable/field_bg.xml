<?xml version="1.0" encoding="utf-8"?>
<!-- Text field: a glass capsule at rest; on focus it brightens and gains an edge in the selector
     colour (ink in light, silver in dark). Same capsule shape as the rows and buttons. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="150" android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/glass_strong" />
            <stroke android:width="2dp" android:color="@color/focus_fill" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/glass" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
